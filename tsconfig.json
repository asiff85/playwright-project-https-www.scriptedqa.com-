{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "*": ["*"]
    }
  },
  "include": [
    "pages/**/*.ts",
    "features/**/*.ts",
    "step-definitions/**/*.ts",
    "fixtures/**/*.ts",
    "hooks/**/*.ts",
    "utils/**/*.ts",
    "runner/**/*.ts",
    "test-data/**/*.json"
  ]
}

